# ──────────────────────────────────────────────
# .env.example — Fake News Detection Engine
# Copy this file to .env and fill in your API keys
# ──────────────────────────────────────────────

# Google Fact Check Tools API (required)
GOOGLE_FACT_CHECK_API_KEY="your-google-fact-check-api-key-here"

# NewsAPI.org (required)
NEWS_API_KEY="your-newsapi-key-here"

# Groq API - Llama 3.3 70B (required, replaces Guardian)
GROQ_API_KEY="your-groq-api-key-here"

# Optional: Redis cache connection (leave blank to use in-memory cache)
REDIS_URL=""

# Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL_SECONDS=86400

# Flask secret key (change in production)
FLASK_SECRET="your-secure-random-secret-here"
