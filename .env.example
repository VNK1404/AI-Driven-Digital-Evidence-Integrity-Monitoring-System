# ── System Configuration ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=false

# ── OCR / External Tools ──────────────────────────────────────────────────────
# Path to Tesseract-OCR executable on your machine
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── API Keys for Fake News External Verification (Optional) ───────────────────
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_FACT_CHECK_API_KEY=your_google_api_key_here
NEWS_API_KEY=your_news_api_key_here

# ── Redis Cache (Optional — falls back to memory cache if omitted) ───────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase Database (Optional — falls back to local SQLite if omitted) ─────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

